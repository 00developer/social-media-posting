# Root .env, loaded by every backend service in services/*. Copy to .env and fill in.
# apps/web does NOT read this file - it needs its own apps/web/.env.local (see apps/web/.env.local.example).

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend ONLY. Bypasses Row Level Security. Never expose to the frontend or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (BullMQ needs a real Redis protocol endpoint, e.g. a free Upstash database) ---
REDIS_URL=redis://localhost:6379
# Optional: Upstash's REST API, used only for role cache / feed cache / rate limiting / analytics
# counters. Without these the same features silently degrade (no role cache, no rate limiting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Token encryption ---
# 32 characters. Encrypts stored OAuth tokens at rest. Set your own - don't rely on the code's
# fallback, and don't change it after tokens have been stored (existing tokens become undecryptable).
ENCRYPTION_KEY=

# --- API_BASE_URL ---
# The backend's own public URL (a tunnel like cloudflared in local dev, or your deployed backend's
# URL in production). Used to build every OAuth redirect URI: <API_BASE_URL>/api/v1/auth/<platform>/callback
# - register that exact URL with each provider you enable below.
API_BASE_URL=http://localhost:3001

# --- Service-to-service URLs (backend only, not read by the browser) ---
# Only needed if you deploy each service to its own host/URL; on localhost the defaults just work.
ACCOUNT_SERVICE_URL=http://localhost:3001
PUBLISHING_SERVICE_URL=http://localhost:3003

# --- Meta (Facebook / Instagram) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Threads (separate app from the Facebook one above, still a Meta app) ---
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# --- YouTube (Google Cloud project) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/youtube/callback

# --- Twitter/X (optional - falls back to a 'mock' client if unset) ---
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LinkedIn (optional - not wired up for real publishing yet, see README) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/auth/linkedin/callback

# --- Pinterest (optional) ---
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3001/api/v1/auth/pinterest/callback
