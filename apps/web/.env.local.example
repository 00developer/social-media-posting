# apps/web reads its own .env.local (not the root .env). Copy this to apps/web/.env.local and fill in.
# All of these end up in the browser bundle (NEXT_PUBLIC_*), so only put values that are safe to be public.

# --- Supabase (the anon key is safe to expose - Row Level Security protects the data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend service URLs the browser calls directly ---
# On localhost these default to the ports below if unset, so this section is only needed once you
# deploy the backend somewhere other than your own machine (see README's "Deploying" section).
NEXT_PUBLIC_ACCOUNT_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_POST_SERVICE_URL=http://localhost:3002
NEXT_PUBLIC_SCHEDULING_SERVICE_URL=http://localhost:3004
NEXT_PUBLIC_MEDIA_SERVICE_URL=http://localhost:3006
NEXT_PUBLIC_TEAM_SERVICE_URL=http://localhost:3009
