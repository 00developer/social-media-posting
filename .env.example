# Supabase Configuration
# SUPABASE_URL: The API URL of your Supabase project
SUPABASE_URL=

# SUPABASE_ANON_KEY: Safe to expose in the frontend
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Backend ONLY. Bypasses RLS. Never expose to frontend or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=

# Redis Configuration
REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/account-service/youtube/callback
