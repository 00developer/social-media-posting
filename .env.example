# Root .env, loaded by every backend service in services/*. Copy to .env and fill in.
# apps/web does NOT read this file at runtime - it needs its own apps/web/.env.local for local dev
# (see apps/web/.env.local.example). The NEXT_PUBLIC_* block near the bottom is the one exception:
# it's read only by `docker compose build` (Docker Compose fills its ${...} build args from this
# file), not by the app itself - see docker-compose.yml and apps/web/Dockerfile.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend ONLY. Bypasses Row Level Security. Never expose to the frontend or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (BullMQ needs a real Redis protocol endpoint, e.g. a free Upstash database) ---
REDIS_URL=redis://localhost:6379
# Optional: Upstash's REST API, used only for role cache / feed cache / rate limiting / analytics
# counters. Without these the same features silently degrade (no role cache, no rate limiting).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Token encryption ---
# Required, exactly 32 characters. Encrypts stored OAuth tokens at rest. account-service/publishing-service/
# analytics-service all refuse to start without it (no insecure default - don't change it after tokens have been
# stored, or existing tokens become undecryptable).
ENCRYPTION_KEY=

# --- API_BASE_URL ---
# The backend's own public URL (a tunnel like cloudflared in local dev, or your deployed backend's
# URL in production). Used to build every OAuth redirect URI: <API_BASE_URL>/api/v1/auth/<platform>/callback
# - register that exact URL with each provider you enable below.
API_BASE_URL=http://localhost:3001

# --- Service-to-service URLs (backend only, not read by the browser) ---
# Only needed if you deploy each service to its own host/URL; on localhost the defaults just work.
ACCOUNT_SERVICE_URL=http://localhost:3001
PUBLISHING_SERVICE_URL=http://localhost:3003

# --- Meta (Facebook / Instagram) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Threads (separate app from the Facebook one above, still a Meta app) ---
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# --- YouTube (Google Cloud project) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/youtube/callback

# --- Twitter/X (optional - falls back to a 'mock' client if unset) ---
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LinkedIn (optional - not wired up for real publishing yet, see README) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/auth/linkedin/callback

# --- Pinterest (optional) ---
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3001/api/v1/auth/pinterest/callback

# --- AI Assistant (optional - caption generator + comment-reply suggestions silently no-op without a key) ---
# Free: get a key at https://aistudio.google.com/apikey (no credit card needed). Rate-limited, not pay-per-token -
# see https://ai.google.dev/gemini-api/docs/rate-limits for the current free-tier limits per model.
GEMINI_API_KEY=
# Model ids are Google's own names - see https://ai.google.dev/gemini-api/docs/models for the current list
# (Google renames/retires preview models fairly often; "-latest" aliases track the current recommended model
# automatically). Safe to leave at the defaults (Flash Lite: cheap, fast, vision-capable, and less congested on
# the free tier than the full Flash model); raise AI_GENERATE_MODEL to "gemini-flash-latest" or a Pro-tier model
# whenever quality matters more than speed/reliability, no code change needed (see packages/ai/src/client.ts).
AI_CLASSIFY_MODEL=gemini-flash-lite-latest
AI_GENERATE_MODEL=gemini-flash-lite-latest
# Hard safety cap on AI generations per team per month, purely to stop a bug from running up cost.
# Not a product-level plan limit (that's still undecided) - raise it freely.
AI_SAFETY_CEILING=500

# --- Docker Compose build args only (see the note at the top of this file) ---
# The real values normally live in apps/web/.env.local for local dev; duplicated here because
# `docker compose build` bakes them into the web image at build time and only reads this file.
# Leave at localhost defaults for testing the built images on your own machine; set them to the
# real deployed backend URLs before building for an actual deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ACCOUNT_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_POST_SERVICE_URL=http://localhost:3002
NEXT_PUBLIC_SCHEDULING_SERVICE_URL=http://localhost:3004
NEXT_PUBLIC_MEDIA_SERVICE_URL=http://localhost:3006
NEXT_PUBLIC_TEAM_SERVICE_URL=http://localhost:3009
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:3008
